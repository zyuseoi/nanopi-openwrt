# --- 你的现有配置 ---
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe -march=armv8-a+crypto+crc -mcpu=cortex-a53+crypto+crc -mtune=cortex-a53"
CONFIG_TARGET_ROOTFS_PARTSIZE=380

# Target Device
CONFIG_TARGET_sunxi=y
CONFIG_TARGET_sunxi_cortexa53=y
CONFIG_TARGET_sunxi_cortexa53_DEVICE_friendlyarm_nanopi-r1s-h5=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_BUILD_SUNXI_SDIMAGE=y

# Basic Network & Kernel Modules (IPv4 only)
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-shortcut-fe=y
CONFIG_PACKAGE_kmod-fast-classifier=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-mii=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb2-pci=y

# Disable ALL IPv6 components
# CONFIG_PACKAGE_kmod-ipv6 is not set
# CONFIG_PACKAGE_kmod-ip6tables is not set
# CONFIG_PACKAGE_kmod-nf-ipt6 is not set
# CONFIG_PACKAGE_kmod-nf-reject6 is not set
# CONFIG_PACKAGE_ip6tables is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set

# Essential Tools
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_zlib=y

# Proxy: ONLY Xray Core via luci-app-ssr-plus
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
# Explicitly disable all other cores
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_SagerNet_Core is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Simple_Obfs is not set

# Remove redundant standalone proxy binaries (Xray covers all protocols)
# CONFIG_PACKAGE_hysteria is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-check is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-local is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir is not set
# CONFIG_PACKAGE_simple-obfs-client is not set
# CONFIG_PACKAGE_sagernet-core is not set
# CONFIG_PACKAGE_shadowsocks-rust-sslocal is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssserver is not set

# Keep generic DNS forwarding tools (useful with Xray transparent proxy)
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_dns2tcp=y
CONFIG_PACKAGE_microsocks=y

# Other Selected Apps
CONFIG_DEFAULT_ddns-scripts_aliyun=y
CONFIG_DEFAULT_ddns-scripts_dnspod=y
CONFIG_DEFAULT_luci-app-ddns=y
CONFIG_DEFAULT_luci-app-arpbind=y
CONFIG_DEFAULT_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-frps=y
CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts_aliyun=y
CONFIG_PACKAGE_ddns-scripts_dnspod=y
CONFIG_PACKAGE_frps=y
CONFIG_PACKAGE_frpc=y

# LuCI i18n (Chinese) — only for enabled apps
CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ramfree-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
CONFIG_PACKAGE_luci-i18n-frps-zh-cn=y
CONFIG_PACKAGE_luci-theme-argonv3=y

# Libraries (minimal set for Xray + network tools)
CONFIG_LIBCURL_COOKIES=y
CONFIG_LIBCURL_CRYPTO_AUTH=y
CONFIG_LIBCURL_FILE=y
CONFIG_LIBCURL_FTP=y
CONFIG_LIBCURL_HTTP=y
CONFIG_LIBCURL_NGHTTP2=y
CONFIG_LIBCURL_OPENSSL=y
CONFIG_LIBCURL_PROXY=y
CONFIG_LIBCURL_TFTP=y
CONFIG_LIBCURL_THREADED_RESOLVER=y
CONFIG_LIBCURL_TLS_SRP=y
CONFIG_LIBCURL_UNIX_SOCKETS=y
CONFIG_LIBSODIUM_MINIMAL=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_libnghttp2=y
CONFIG_PACKAGE_libsodium=y
CONFIG_PACKAGE_libev=y
CONFIG_PACKAGE_libudns=y
CONFIG_PACKAGE_libwebsockets-full=y
CONFIG_PACKAGE_libcares=y
CONFIG_PACKAGE_libpcre=y
CONFIG_PACKAGE_libmnl=y
CONFIG_PACKAGE_libipset=y
CONFIG_PACKAGE_libelf=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libbpf=y

# --- 新增/修改的配置 ---

# Explicitly Disable (Your requested packages for space saving)
# fstab (related to block-mount)
# CONFIG_PACKAGE_block-mount is not set 
# diskman (usually luci-app-diskman or similar disk management UI)
# CONFIG_PACKAGE_luci-app-diskman is not set 
# filetransfer (usually luci-app-filetransfer)
# CONFIG_PACKAGE_luci-app-filetransfer is not set 
# argon-config (usually luci-app-argon-config)
# CONFIG_PACKAGE_luci-app-argon-config is not set 
# cpufreq (you already had this disabled, keeping it)
# CONFIG_PACKAGE_luci-app-cpufreq is not set 
# koolproxy (usually luci-app-koolproxy*)
# CONFIG_PACKAGE_luci-app-koolproxyR is not set 
# CONFIG_PACKAGE_luci-app-koolproxyR-plus is not set 
# aliyundrive-webdav (usually luci-app-aliyundrive-webdav)
# CONFIG_PACKAGE_luci-app-aliyundrive-webdav is not set 
# AdGuardHome (usually luci-app-adguardhome2 or adguardhome binary)
# CONFIG_PACKAGE_luci-app-adguardhome2 is not set 
# CONFIG_PACKAGE_AdGuardHome is not set 
# serverchan (usually luci-app-serverchan or similar)
# CONFIG_PACKAGE_luci-app-serverchan is not set 
# xlnetacc (usually luci-app-xlnetacc)
# CONFIG_PACKAGE_luci-app-xlnetacc is not set 
# vlmcsd (you already had this disabled, keeping it)
# CONFIG_PACKAGE_luci-app-vlmcsd is not set 
# CONFIG_PACKAGE_vlmcsd is not set 
# usb_printer (usually kmod-usb-printer)
# CONFIG_PACKAGE_kmod-usb-printer is not set 
# vsftpd (usually luci-app-vsftpd)
# CONFIG_PACKAGE_luci-app-vsftpd is not set 
# CONFIG_PACKAGE_vsftpd is not set 
# nas/cifs (usually kmod-fs-cifs or luci-app-cifs)
# CONFIG_PACKAGE_kmod-fs-cifs is not set 
# CONFIG_PACKAGE_luci-app-cifs is not set 
# zerotier (usually luci-app-zerotier)
# CONFIG_PACKAGE_luci-app-zerotier is not set 

# Enable Docker (this overrides any previous disable statements for Docker)
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_luci-app-docker=y
# If you also want the Dockerman UI, uncomment the next line
# CONFIG_PACKAGE_luci-app-dockerman=y
# If you need python3-docker library
# CONFIG_PACKAGE_python3-docker=y
# CONFIG_PACKAGE_python3-dockerpty=y

# --- End of your modified configuration ---
